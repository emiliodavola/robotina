# Variables requeridas por compose.yml (un unico contenedor `robotina`).
# Copiar a .env, que git ignora.
#
# Nunca uses `docker inspect` sin un `--format` estrecho: la forma desnuda
# imprime .Config.Env con las claves en claro. Regla: todo `docker inspect`
# lleva un `--format` que NO toque el bloque de entorno, por ejemplo
#   docker inspect --format '{{.State.Status}}' robotina
#
# Dos claves OpenCode Go, con nombres distintos a proposito:
#   - HERMES_OPENCODE_GO_API_KEY: compose la publica en el contenedor como
#     OPENCODE_GO_API_KEY, el nombre exacto que espera la imagen vendor de
#     Hermes. La usa el proceso Hermes.
#   - OPENCODE_GO_API_KEY: compose la publica como ROBOTINA_OPENCODE_GO_API_KEY.
#     El run script de `opencode` la reexporta como OPENCODE_GO_API_KEY SOLO en
#     su propio proceso. La usa el servidor OpenCode.
TELEGRAM_BOT_TOKEN=
HERMES_OPENCODE_GO_API_KEY=
OPENCODE_GO_API_KEY=
TELEGRAM_ALLOWED_USERS=
OPENCODE_SERVER_PASSWORD=
HOST_DATA_DIR=
GITHUB_TOKEN=
