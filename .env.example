# Variables requeridas por compose.yml (un unico contenedor `robotina`).
# Copiar a .env, que git ignora.
#
# --- Por que los nombres llevan el prefijo ROBOTINA_ ------------------------
# Docker Compose le da PRECEDENCIA al entorno del proceso por sobre este archivo.
# Si quedaste con una variable exportada en tu shell con el mismo nombre que una
# de estas claves (el caso real fue OPENCODE_GO_API_KEY, el nombre propio del
# vendor), ese valor exportado pisa en silencio al del .env y el contenedor
# recibe una credencial vieja. El prefijo ROBOTINA_ no existe en el entorno del
# host, asi que la colision es imposible. Adentro del contenedor, en cambio,
# cada componente conserva el nombre exacto que espera.
#
# Nunca uses `docker inspect` sin un `--format` estrecho: la forma desnuda
# imprime .Config.Env con las claves en claro. Regla: todo `docker inspect`
# lleva un `--format` que NO toque el bloque de entorno, por ejemplo
#   docker inspect --format '{{.State.Status}}' robotina
#
# Dos claves de modelo OpenCode Go, con nombres distintos a proposito:
#   - ROBOTINA_HERMES_MODEL_KEY: compose la publica en el contenedor como
#     OPENCODE_GO_API_KEY, el nombre exacto que espera la imagen vendor de
#     Hermes. La usa el proceso Hermes.
#   - ROBOTINA_OPENCODE_MODEL_KEY: compose la publica como
#     ROBOTINA_OPENCODE_GO_API_KEY. El run script de `opencode` la reexporta como
#     OPENCODE_GO_API_KEY SOLO en su propio proceso. La usa el servidor OpenCode.
#
# Modelo de Hermes (NO son secretos). Los aplica el cont-init 30-robotina-model
# en cada arranque. Dejalos vacios para usar el default entre parentesis.
#   ROBOTINA_HERMES_MODEL_PROVIDER=   # proveedor (default: opencode-go)
#   ROBOTINA_HERMES_MODEL_BASE_URL=   # endpoint  (default: https://opencode.ai/zen/go/v1)
#   ROBOTINA_HERMES_MODEL=            # id del modelo (default: deepseek-v4.1-flash)

# Prefijos escribibles por las herramientas de archivo de Hermes, separados por
# ":" (os.pathsep). El default es HERMES_HOME + el workspace entero. Los dos son
# directorios, por eso llevan barra final. Acotalo si necesitas menos.
#   ROBOTINA_HERMES_WRITE_SAFE_ROOT=  # default: /opt/data/:/workspace/
ROBOTINA_TELEGRAM_BOT_TOKEN=
ROBOTINA_HERMES_MODEL_KEY=
ROBOTINA_OPENCODE_MODEL_KEY=
ROBOTINA_TELEGRAM_ALLOWED_USERS=
ROBOTINA_OPENCODE_SERVER_PASSWORD=
HOST_DATA_DIR=
ROBOTINA_GITHUB_TOKEN=
ROBOTINA_HERMES_MODEL=
ROBOTINA_HERMES_MODEL_PROVIDER=
ROBOTINA_HERMES_MODEL_BASE_URL=
ROBOTINA_HERMES_WRITE_SAFE_ROOT=
ROBOTINA_OPENCODE_DELEGATE_MODEL=
ROBOTINA_TMPDIR=