#!/bin/sh
# Wrapper del CLI `opencode` para el shell del agente.
#
# Por que existe: `opencode` NO tiene almacen de credenciales (no hay auth.json
# bajo /opt/data/.local/share/opencode): lee la clave del entorno. En el shell
# del agente, OPENCODE_GO_API_KEY trae la clave de HERMES, porque la variable a
# nivel contenedor tiene que llevarla para el entrypoint del vendor. La clave
# propia de OpenCode vive en ROBOTINA_OPENCODE_GO_API_KEY y hasta ahora solo la
# exportaba el run script del servicio `opencode`.
#
# Consecuencia sin este wrapper: un CLI `opencode` lanzado a mano desde el
# agente se autenticaria con la clave de Hermes y romperia la propiedad "cada
# agente configurado solo con su propia clave" (spec agent-credentials, CR1).
#
# Este wrapper reexporta la clave correcta para el proceso del CLI. Si
# ROBOTINA_OPENCODE_GO_API_KEY no esta definida, no cambia nada: exec directo al
# binario real (passthrough), de modo que degrada en vez de romper.
#
# Nunca imprime ni registra la clave. El destino va por ruta absoluta: la
# resolucion por PATH la hace /opt/robotina/bin, que va primero y es root-owned
# (mejor que el /opt/data/.local/bin escribible por el agente).
if [ -n "${ROBOTINA_OPENCODE_GO_API_KEY:-}" ]; then
  OPENCODE_GO_API_KEY="$ROBOTINA_OPENCODE_GO_API_KEY"
  export OPENCODE_GO_API_KEY
fi

exec /usr/local/bin/opencode "$@"
